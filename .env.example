# 复制为 .env 后填写真实配置；不要把凭据填入本模板。
# AI_PROVIDER / AI_MODEL 必填；来源 upstream/lib/ai-providers.ts:740、769。
AI_PROVIDER=deepseek
# 必须为提供方支持的模型 ID；此处沿用本机已有配置，不代表所有账号均可用。
AI_MODEL=deepseek-flash
# 使用 deepseek 时必填，来源 upstream/lib/ai-providers.ts:1072。
DEEPSEEK_API_KEY=

# 可选，留空使用提供方默认地址；来源 upstream/lib/ai-providers.ts:1075。
DEEPSEEK_BASE_URL=
# 可选，逗号分隔的访问码，留空不校验；来源 upstream/app/api/scoped-edit/route.ts:57。
ACCESS_CODE_LIST=
# 可选，留空禁用后台；来源 upstream/docs/cn/admin-panel.md:7。
ADMIN_PASSWORD=

# 可选，部署构建参数；来源 tools/gen-override.py 的 args。
# 浏览器可访问的 draw.io 地址，修改后 ./deploy.sh deploy 重建应用。
DRAWIO_PUBLIC_URL=http://localhost:8080
# 可选，构建使用的 npm 源；来源 tools/gen-override.py。
NPM_REGISTRY=https://registry.npmmirror.com

# 可选，插件直连后备 API 地址；来源 tools/gen_drawio_custom.py:58。
# 正常优先走主应用代理，不需要独立 8787 服务。
# 浏览器必须能够访问；修改后 ./deploy.sh up 更新入口和 CSP，再刷新页面。
AI_SCOPE_ENDPOINT=http://localhost:3000
